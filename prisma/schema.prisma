// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  vatNumber String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  quotes    Quote[]
  rules     Rule[]
  units     Unit[]
}

model Unit {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String   // e.g., "Square Meter"
  symbol    String   // e.g., "m2"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
}

model Product {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  sku         String?
  
  // Pricing
  basePrice   Decimal  @db.Decimal(10, 2)
  currency    String   @default("EUR")
  
  // Units
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])

  // Categorization
  category    String?
  tags        String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quoteLines  QuoteLine[]
}

model Rule {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  
  // Logic
  priority    Int      @default(0)
  conditions  Json     // e.g. { "field": "quantity", "operator": "gte", "value": 10 }
  actions     Json     // e.g. { "type": "DISCOUNT_PERCENT", "value": 5 }
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  
  reference       String   @unique
  customerName    String
  customerEmail   String?
  
  // Status
  status          String   @default("DRAFT") // DRAFT, VALIDATED, SENT, ACCEPTED, REJECTED
  
  // Financials
  totalAmount     Decimal  @default(0) @db.Decimal(10, 2)
  currency        String   @default("EUR")
  
  // AI & Traceability (Anti-Hallucination)
  inputPrompt     String?  @db.Text
  aiResponse      Json?    // Stores the raw extraction from AI
  validationErrors Json?   // List of missing fields or constraint violations
  isValid         Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  lines           QuoteLine[]
  auditLogs       AuditLog[]
}

model QuoteLine {
  id          String   @id @default(uuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id])
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  
  description String?  // Specific overrides
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  
  metadata    Json?    // Applied rules or conversions
}

model AuditLog {
  id        String   @id @default(uuid())
  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id])
  
  action    String   // e.g., "QUOTE_CREATED", "RULE_APPLIED", "AI_PARSING"
  details   Json
  
  timestamp DateTime @default(now())
}
