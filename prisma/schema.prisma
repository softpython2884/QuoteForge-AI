// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  vatNumber String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  quotes    Quote[]
  rules     Rule[]
  units     Unit[]
  conversions UnitConversion[]
}

model Unit {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String   // e.g., "Square Meter"
  symbol    String   // e.g., "m2"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
  
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
}

model Product {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  sku         String?
  
  // Pricing
  basePrice   Decimal
  currency    String   @default("EUR")
  
  // Units
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])

  // Categorization
  category    String?
  material    String? // e.g., "Wood", "Ceramic"
  dimensions  String? // e.g., "60x60cm", "10L"
  tags        String? // SQLite does not support arrays, changed to optional String (CSV)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quoteLines  QuoteLine[]
}

model UnitConversion {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  
  fromUnitId  String
  fromUnit    Unit     @relation("FromUnit", fields: [fromUnitId], references: [id])
  
  toUnitId    String
  toUnit      Unit     @relation("ToUnit", fields: [toUnitId], references: [id])
  
  factor      Decimal  // Multiplier: 1 pack = 1.5 m2 -> factor 1.5
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Rule {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  
  // Logic
  priority    Int      @default(0)
  conditions  String     // e.g. { "field": "quantity", "operator": "gte", "value": 10 }
  actions     String     // e.g. { "type": "DISCOUNT_PERCENT", "value": 5 }
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  
  reference       String   @unique
  customerName    String
  customerEmail   String?
  
  // Status
  status          String   @default("DRAFT") // DRAFT, VALIDATED, SENT, ACCEPTED, REJECTED
  
  // Financials
  totalAmount     Decimal  @default(0)
  currency        String   @default("EUR")
  
  // AI & Traceability (Anti-Hallucination)
  inputPrompt     String?
  aiResponse      String?    // Stores the raw extraction from AI
  validationErrors String?   // List of missing fields or constraint violations
  isValid         Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  lines           QuoteLine[]
  auditLogs       AuditLog[]
}

model QuoteLine {
  id          String   @id @default(uuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id])
  
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  
  description String?  // Specific overrides
  quantity    Decimal
  unitPrice   Decimal
  totalPrice  Decimal
  
  metadata    String?    // Applied rules or conversions
}

model AuditLog {
  id        String   @id @default(uuid())
  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id])
  
  action    String   // e.g., "QUOTE_CREATED", "RULE_APPLIED", "AI_PARSING"
  details   String
  
  timestamp DateTime @default(now())
}
